  m_Script: {fileID: 11500000, guid: 77ac5fd421b0d27498386e4d58adcb1d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraction
  player: {fileID: 1498796109}
  introDirector: {fileID: 1485680200}
  dialogueManager: {fileID: 1676415455}
  interactionDistance: 2.5
  textDelay: 0
  interactionPrompt: {fileID: 529180179}
